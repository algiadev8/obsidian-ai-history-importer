{
	"name": "obsidian-ai-history-importer",
	"private": true,
	"version": "0.1.0",
	"packageManager": "pnpm@9.15.0",
	"scripts": {
		"build": "pnpm -r run build",
		"dev": "pnpm --filter plugin run dev",
		"lint": "pnpm -r run lint",
		"test": "pnpm -r run test",
		"format": "prettier -w .",
		"format:check": "prettier -c .",
		"version:bump": "node ./scripts/version-bump.mjs",
		"version:patch": "pnpm run version:bump patch",
		"version:minor": "pnpm run version:bump minor",
		"version:major": "pnpm run version:bump major"
	},
	"pnpm": {
		"overrides": {
			"vite": "^7.3.7",
			"obsidian>moment": "^2.31.0"
		}
	},
	"devDependencies": {
		"@types/node": "^25.9.9",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.5",
		"prettier": "^3.9.10",
		"typescript": "^5.9.3",
		"vite": "^7.3.7"
	}
}
